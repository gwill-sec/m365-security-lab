// Password spray: one IP failing against many distinct users in a short window.
SigninLogs
| where TimeGenerated > ago(3h)
| where ResultType == "50126"
| summarize FailedAttempts = count(),
            TargetedUsers = dcount(UserPrincipalName),
            UsersTargeted = make_set(UserPrincipalName),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
            by IPAddress
| where TargetedUsers >= 3                           // tune threshold per environment
| order by TargetedUsers desc

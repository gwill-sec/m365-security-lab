// The question that decides severity: did any sprayed account actually succeed?
let SprayIPs = SigninLogs
    | where TimeGenerated > ago(3h)
    | where ResultType == "50126"
    | summarize TargetedUsers = dcount(UserPrincipalName) by IPAddress
    | where TargetedUsers >= 3
    | project IPAddress;                             // let = save a sub-query result as a variable
SigninLogs
| where TimeGenerated > ago(3h)
| where IPAddress in (SprayIPs)                      // only the spraying IPs
| where ResultType == "0"                            // successful sign-ins
| where UserPrincipalName !startswith "admin"        // exclude known-good (office IPs in production)
| project TimeGenerated, UserPrincipalName, AppDisplayName, IPAddress, AuthenticationRequirement
| order by TimeGenerated asc
// AuthenticationRequirement = singleFactorAuthentication => password-only compromise.
